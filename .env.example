# Vercel Environment Variables
# Ces variables doivent être configurées dans le dashboard Vercel

# Supabase (pour l'authentification et le stockage)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# YouTube Transcript API (serveur backend dédié)
# Exemple: https://your-transcript-server.railway.app
VITE_TRANSCRIPT_API_URL=http://localhost:3001

# Note: Ne commitez JAMAIS vos vraies clés API dans Git
# Configurez-les directement dans Vercel Dashboard > Settings > Environment Variables
