{
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "StudeoApp",
    "version": "3.1.7"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "dialog": {
        "all": true
      },
      "fs": {
        "all": true
      },
      "http": {
        "all": true,
        "request": true,
        "scope": [
          "https://www.youtube.com/*",
          "https://youtube.com/*",
          "https://*.youtube.com/*",
          "https://i.ytimg.com/*",
          "https://www.youtube.com/api/timedtext*"
        ]
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.studeo.app.v2",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "macOS": {
        "entitlements": "entitlements.plist"
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "maximized": true,
        "resizable": true,
        "title": "Studeo - L'outil pour tout apprendre",
        "width": 1280,
        "height": 800
      }
    ]
  }
}