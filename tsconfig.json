{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "composite": true
  },
  "include": [
    "vite-env.d.ts",
    "index.tsx",
    "App.tsx",
    "types.ts",
    "constants.ts",
    "constants/**/*.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "services/**/*.ts",
    "services/**/*.tsx",
    "utils/**/*.ts",
    "contexts/**/*.ts",
    "contexts/**/*.tsx",
    "locales/**/*.ts",
    "data/**/*.ts",
    "stores/**/*.ts",
    "stores/**/*.tsx",
    "routes/**/*.ts",
    "routes/**/*.tsx",
    "router.tsx"
  ],
  "exclude": [
    "node_modules",
    "src-tauri",
    "dist",
    "vite.config.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
